# Configuration
SITE_URL = "https://anime-sama.tv/"
CONFIG_DIR = Path(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
) / "anime-sama-cli"
CONFIG_FILE = CONFIG_DIR / "config.json"
ANIME_SAMA_API_CONFIG_DIR = Path(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
) / "anime-sama_api"
